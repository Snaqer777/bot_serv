# ===== Обязательные =====

# Токен бота от @BotFather
BOT_TOKEN=123456789:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Твой числовой Telegram ID (бот подскажет его командой /myid)
ADMIN_ID=123456789

# Адрес панели 3x-ui РОВНО так, как ты открываешь её в браузере.
# Без слеша на конце. Если панель с секретным путём — укажи его:
#   https://1.2.3.4:2053
#   https://1.2.3.4:2053/abc123
XUI_URL=https://1.2.3.4:2053

# Логин и пароль от панели 3x-ui
XUI_USERNAME=admin
XUI_PASSWORD=your_password

# ID входящего подключения (VLESS + TCP + Reality).
# Узнать можно командой /inbounds у бота.
XUI_INBOUND_ID=1

# ===== Необязательные (обычно не трогай) =====

# Адрес сервера, который будет внутри ключа vless://.
# По умолчанию берётся хост из XUI_URL.
# VPN_HOST=vpn.example.com

# Порт в ключе. По умолчанию — порт входящего подключения из панели.
# VPN_PORT=443

# Вручную переопределить параметры Reality (по умолчанию читаются из панели автоматически):
# REALITY_PUBLIC_KEY=
# REALITY_SNI=
# REALITY_SHORT_ID=
# REALITY_FP=chrome
