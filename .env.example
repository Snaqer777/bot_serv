# =================================================================
# ОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ ДЛЯ RAILWAY (Variables)
# =================================================================

# 1. Токен бота из Telegram (получи у @BotFather)
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. Твой личный Telegram ID (узнай у бота командой /myid)
ADMIN_ID=123456789

# 3. Полный адрес твоей панели 3x-ui РОВНО так, как ты открываешь её в браузере:
#    - БЕЗ слэша на конце!
#    - Обязательно укажи порт (например :2053)
#    - Если при установке панели настроен секретный путь (webBasePath), укажи его:
#      Примеры:
#      http://194.87.12.34:2053
#      https://194.87.12.34:2053
#      https://vpn.example.com:2053/mysecret
XUI_URL=http://194.87.12.34:2053

# 4. Логин администратора панели 3x-ui
XUI_USERNAME=admin

# 5. Пароль администратора панели 3x-ui
XUI_PASSWORD=your_strong_password


# =================================================================
# РЕКОМЕНДУЕМЫЕ / ОПЦИОНАЛЬНЫЕ ПЕРЕМЕННЫЕ
# =================================================================

# ID подключения в 3x-ui (VLESS + TCP + Reality).
# Если оставить 0 или не указывать, бот автоматически выберет первое подходящее!
# Чтобы зафиксировать конкретное, посмотри список командой /inbounds у бота.
XUI_INBOUND_ID=1

# Если в 3x-ui сгенерирован API Token (в настройках панели) — можно указать его.
# При указании XUI_TOKEN логин и пароль не требуются, и работает даже с 2FA.
# XUI_TOKEN=your_3xui_bearer_token

# Секрет двухфакторной аутентификации (Google Authenticator), если в панели 3x-ui
# включена 2FA: Settings -> Security -> Two-factor authentication -> секрет из QR-кода.
# Бот сам считает 6-значный код при каждом входе в панель. Можно вставить как сам
# base32-секрет, так и целиком ссылку otpauth://... из QR-кода (пробелы не важны).
# Проверить секрет: python bot.py --totp (локально) или команда /totp (в боте).
# XUI_2FA_SECRET=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP

# Адрес VPN-сервера для клиентов внутри ключа vless://.
# По умолчанию бот берёт IP/домен из XUI_URL.
# Укажи, если панель висит на одном IP/домене, а VPN трафик идёт через другой:
# VPN_HOST=194.87.12.34

# Порт VPN-подключения (по умолчанию берётся порт из настроек входящего подключения в панели):
# VPN_PORT=443

# Ручное переопределение параметров Reality (по умолчанию бот считывает их автоматически из панели):
# REALITY_PUBLIC_KEY=
# REALITY_SNI=www.microsoft.com
# REALITY_SHORT_ID=
# REALITY_FP=chrome

# Прокси для запросов бота к панели (если хостер сервера блокирует прямые запросы из дата-центров Railway):
# XUI_PROXY=http://user:pass@host:port
