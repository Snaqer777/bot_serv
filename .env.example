# =================================================================
# ОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ ДЛЯ RAILWAY (Variables)
# =================================================================

# 1. Токен бота из Telegram (получи у @BotFather)
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. Твой личный Telegram ID (узнай у бота командой /myid).
#    Можно указать нескольких администраторов через запятую — тогда админ-команды
#    (/panel_debug, /groups, /test_pay, /payments) доступны каждому из них:
#      ADMIN_ID=123456789,987654321
#    ВАЖНО: именно ЧИСЛО, а не @username. Если оставить пустым — админ-команды
#    открыты для всех (бот предупредит об этом при старте и в /myid).
ADMIN_ID=123456789

# 3. Полный адрес твоей панели 3x-ui РОВНО так, как ты открываешь её в браузере:
#    - БЕЗ слэша на конце!
#    - Обязательно укажи порт (например :2053)
#    - Если при установке панели настроен секретный путь (webBasePath), укажи его:
#      Примеры:
#      http://194.87.12.34:2053
#      https://194.87.12.34:2053
#      https://vpn.example.com:2053/mysecret
XUI_URL=http://194.87.12.34:2053

# 4. Логин администратора панели 3x-ui
XUI_USERNAME=admin

# 5. Пароль администратора панели 3x-ui
XUI_PASSWORD=your_strong_password


# =================================================================
# РЕКОМЕНДУЕМЫЕ / ОПЦИОНАЛЬНЫЕ ПЕРЕМЕННЫЕ
# =================================================================

# ID подключения в 3x-ui (VLESS + TCP + Reality).
# Если оставить 0 или не указывать, бот автоматически выберет первое подходящее!
# Чтобы зафиксировать конкретное, посмотри список командой /inbounds у бота.
XUI_INBOUND_ID=1

# Локации (серверы). Обе локации живут в ОДНОЙ панели 3x-ui как разные входящие.
# ID подключения для каждой локации: посмотреть список — команда /inbounds,
# проверить привязку — /panel_debug (раздел «🌍 Локации (серверы)»).
# Если эти переменные не задавать, бот найдёт подключение по названию в панели
# (Стокгольм / Stockholm, Варшава / Warsaw) или возьмёт общий XUI_INBOUND_ID.
XUI_INBOUND_STOCKHOLM=1
XUI_INBOUND_WARSAW=2

# Группа, в которую бот складывает всех своих клиентов (раздел «Группы» в 3x-ui).
# Требуется панель 3x-ui 3.2 или новее.
# Укажи название УЖЕ СОЗДАННОЙ группы — бот найдёт её в панели и будет складывать
# клиентов в неё. Регистр не важен: «bot-test» найдёт группу «Bot-Test».
# Если такой группы в панели нет, бот создаст новую и предупредит об этом в ответе.
# Посмотреть точные названия групп панели: команда /groups у бота.
# XUI_CLIENT_GROUP=bot-test

# Если в 3x-ui сгенерирован API Token (в настройках панели) — можно указать его.
# При указании XUI_TOKEN логин и пароль не требуются, и работает даже с 2FA.
# XUI_TOKEN=your_3xui_bearer_token

# Секрет двухфакторной аутентификации (Google Authenticator), если в панели 3x-ui
# включена 2FA: Settings -> Security -> Two-factor authentication -> секрет из QR-кода.
# Бот сам считает 6-значный код при каждом входе в панель. Можно вставить как сам
# base32-секрет, так и целиком ссылку otpauth://... из QR-кода (пробелы не важны).
# Проверить секрет: python bot.py --totp (локально) или команда /totp (в боте).
# XUI_2FA_SECRET=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP

# Адрес VPN-сервера для клиентов внутри ключа vless://.
# По умолчанию бот берёт IP/домен из XUI_URL.
# Укажи, если панель висит на одном IP/домене, а VPN трафик идёт через другой:
# VPN_HOST=194.87.12.34

# Порт VPN-подключения (по умолчанию берётся порт из настроек входящего подключения в панели):
# VPN_PORT=443

# --- Ссылка-подписка (сервис подписок 3x-ui) ---
# Клиент получает не отдельный ключ, а ссылку-подписку: приложение по ней само забирает
# конфигурацию и обновляет её (сменили inbound или добавили локацию — клиенту не нужно
# ничего пересылать). Адрес сервиса подписок бот спрашивает у панели
# (Settings -> Subscription) и проверяет запросом, поэтому обычно переменные НЕ нужны.
# Задавай их, только если панель стоит за обратным прокси или бот определил адрес неверно:
#   SUB_URL_BASE=https://sub.example.com:2096  — адрес сервиса подписок (можно с путём);
#   SUB_PORT=2096                              — порт, если он не входит в SUB_URL_BASE;
#   SUB_PATH=/sub/                             — путь, если отличается от настроек панели.
# Если сервис подписок выключен в панели, клиент получит ключ vless, а админ — предупреждение.
# Проверить адреса и доступность: /panel_debug (нужен ADMIN_TOOLS=1).
# SUB_URL_BASE=
# SUB_PORT=
# SUB_PATH=

# Ручное переопределение параметров Reality (по умолчанию бот считывает их автоматически из панели):
# REALITY_PUBLIC_KEY=
# REALITY_SNI=www.microsoft.com
# REALITY_SHORT_ID=
# REALITY_FP=chrome

# Прокси для запросов бота к панели (если хостер сервера блокирует прямые запросы из дата-центров Railway):
# XUI_PROXY=http://user:pass@host:port

# =================================================================
# ОПЛАТА ПОДПИСОК (ОПЦИОНАЛЬНО)
# =================================================================
# Режим приёма оплаты. Если не задан, бот выбирает сам:
#   provider → если задан PAYMENT_PROVIDER_TOKEN,
#   иначе yookassa → если заданы ключи ЮKassa,
#   иначе platega → если заданы Merchant ID и API-ключ Platega,
#   иначе stars.
#   • stars     — Telegram Stars (⭐️ XTR). Ничего, кроме выбора режима, не нужно:
#                 оплата приходит звёздами, доступ (ссылка-подписка) выдаётся сразу.
#   • platega   — оплата картой, через СБП, электронные кошельки и криптовалюту на
#                 странице Platega: бот создаёт транзакцию через API и присылает ссылку
#                 на оплату, а доступ выдаётся после callback-уведомления Platega на
#                 наш вебхук. Инструкция: PLATEGA.md.
#   • provider  — оплата КАРТОЙ прямо в чате Telegram через платёжный токен BotFather.
#                 Для цифровых товаров Telegram разрешает только Stars, поэтому режим
#                 включай осознанно (например, если продаёшь не цифровой товар).
#   • yookassa  — прямая интеграция с ЮKassa: бот создаёт платёж, присылает ссылку
#                 на оплату (карта/СБП), оплата подтверждается вебхуком.
#   • off       — приём оплаты выключен (остаётся бесплатный тестовый доступ).
# PAYMENTS_MODE=stars

# --- PLATEGA (КАРТА / СБП / КОШЕЛЬКИ / КРИПТА) — только для режима platega ---
# Пошаговая инструкция: PLATEGA.md в этом репозитории.
#
# 1. Кабинет Platega -> Настройки -> Интеграция -> API. Возьми два значения:
#      • Merchant ID (UUID) → PLATEGA_MERCHANT_ID
#      • API-ключ           → PLATEGA_SECRET
# PLATEGA_MERCHANT_ID=00000000-0000-0000-0000-000000000000
# PLATEGA_SECRET=your_api_secret
# PAYMENTS_MODE=platega
#
# 2. В том же кабинете задай Callback URL (Настройки -> Callback URLs):
#      https://ваш-домен/platega/webhook
#    Требования Platega: только HTTPS с доверенным сертификатом, публичный домен
#    (localhost и приватные адреса не принимаются). Домен Railway подходит:
#    сервис бота -> Settings -> Networking -> Generate Domain (бот подхватывает его
#    сам, PUBLIC_BASE_URL можно не задавать).
#    Бот отвечает 200 без тела; если ответа нет 60 секунд — Platega повторит запрос
#    до 3 раз с интервалом 5 минут.
#
# 3. Необязательные настройки Platega:
# PLATEGA_CURRENCY=RUB                 # валюта счёта
# PLATEGA_METHOD=                      # пусто — способ оплаты выбирает плательщик на
#                                      # странице Platega (рекомендуется). Можно
#                                      # зафиксировать один: 2 — СБП (QR), 3 — ЕРИП,
#                                      # 11 — карточный эквайринг, 12 — международная
#                                      # оплата, 13 — криптовалюта, 14 — SberPay.
# PLATEGA_API_URL=https://app.platega.io    # адрес API (менять только если менеджер дал другой)
# PLATEGA_WEBHOOK_PATH=/platega/webhook     # путь callback; его же вписывают в кабинет
# PLATEGA_RETURN_URL=                  # куда вернуть после оплаты (пусто — чат с ботом)
# PLATEGA_FAILED_URL=                  # куда вернуть после неудачи (пусто — чат с ботом)
#
# Проверка настроек без денег: команда /platega_check (админ). Ничего не создаёт
# и не оплачивает: запрашивает балансы магазина и показывает, что ключи приняты, —
# поэтому в боевом режиме остаётся доступной при ADMIN_TOOLS=1.
# Проверка выдачи доступа БЕЗ оплаты (только для админа): команда /test_pay.
# Бот проходит тот же путь, что после настоящей оплаты (клиент в 3x-ui + сообщение
# со ссылкой-подпиской), но денег не списывает и в выручку не попадает.
# В боевом режиме /test_pay в боте нет вообще — она появляется только при этой переменной
# (или при TEST_TOOLS=1), см. TEST_TOOLS ниже.
# PAYMENTS_ALLOW_TEST_PAY=1

# Видимость тестовых команд: TEST_TOOLS=0 прячет /test_pay (бот выглядит полностью
# боевым), TEST_TOOLS=1 включает принудительно.
# Без переменной: /test_pay включается при PAYMENTS_ALLOW_TEST_PAY=1.
# Диагностика /platega_check от этой переменной не зависит: она доступна администратору
# всегда, когда включены служебные команды.
# Важно: проверки оплаты видны только когда включены служебные команды (ADMIN_TOOLS=1).
# TEST_TOOLS=0

# --- ОПЛАТА КАРТОЙ ЧЕРЕЗ TELEGRAM (@BotFather) — только для режима provider ---
# Пошаговая инструкция: TELEGRAM_PAYMENTS.md в этом репозитории.
# @BotFather -> /mybots -> твой бот -> Bot Settings -> Payments -> ЮKassa.
#   • "Connect ЮKassa Test"  — тестовый токен вида 381764678:TEST:100037
#                              (оплата тестовой картой 5555 5555 5555 4477);
#   • "Connect ЮKassa Live"  — бот спросит shopId и shopArticleId (отправь 0),
#                              выдаст боевой токен вида x:LIVE:...
# Для боевого режима магазин ЮKassa нужно перевести на email-протокол:
# напиши в поддержку ЮKassa (ecommerce@yoomoney.ru) свой ShopID.
# PAYMENT_PROVIDER_TOKEN=381764678:TEST:100037

# Чек 54-ФЗ (ЮKassa в Telegram): 1 — бот передаёт данные чека в provider_data и
# просит у покупателя email для чека, 0 — не передавать (по умолчанию).
# Включай 1 только если фискализация подключена (чеки от ЮKassa или своя касса).
# TELEGRAM_SEND_RECEIPT=0
# Ставка НДС в чеке: 1 — без НДС, 2 — 0%, 3 — 10%, 4 — 20%, 5 — 10/110, 6 — 20/120
# TELEGRAM_RECEIPT_VAT_CODE=1

# --- ЮKASSA НАПРЯМУЮ (API v3) — только для режима yookassa ---
# Подробная пошаговая инструкция: YOOKASSA.md в этом репозитории.
# Личный кабинет ЮKassa -> Интеграция -> Ключи API (shopId + секретный ключ).
# Для тестов создай ТЕСТОВЫЙ магазин: ключ начинается с test_ .
# YOOKASSA_SHOP_ID=123456
# YOOKASSA_SECRET_KEY=test_xxxxxxxxxxxxxxxxxxxx
# YOOKASSA_TEST=1
# Адрес API (менять не нужно):
# YOOKASSA_API_URL=https://api.yookassa.ru/v3

# ВЕБХУК: при авторизации по shopId+ключу (Basic Auth) ЮKassa разрешает настраивать
# уведомления ТОЛЬКО в личном кабинете: Интеграция -> HTTP-уведомления ->
# https://ваш-домен/yookassa/webhook (событие payment.succeeded).
# Адрес бот покажет в /panel_debug — он же в ответе на запрос Railway.
# Если у тебя есть OAuth-токен ЮKassa (партнёрская программа), бот зарегистрирует
# вебхук сам через API — укажи его здесь:
# YOOKASSA_OAUTH_TOKEN=token_xxxxxxxxxxxxxxxxxxxx

# Чек 54-ФЗ: 1..6 — ставка НДС (чек передаёт бот), 0 — не передавать (по умолчанию).
# Оставь 0, если фискализации нет или чеки формирует сам сервис («Чеки от ЮKassa»):
# иначе создание платежа может падать с ошибкой.
# YOOKASSA_VAT_CODE=0

# Публичный адрес сервиса (Railway отдаёт его как RAILWAY_PUBLIC_DOMAIN и бот
# подставляет сам). Нужен, чтобы ЮKassa знала, куда присылать уведомления:
# PUBLIC_BASE_URL=https://your-service.up.railway.app

# Порт веб-сервера бота (health /healthz + вебхук ЮKassa). Railway задаёт сам.
# PORT=8080

# Курс пересчёта рублей в звёзды для режима Stars: 1 ⭐️ ≈ 1.6 ₽.
# Цену конкретного тарифа в звёздах можно задать точно: STARS_<ТАРИФ>, например
# STARS_TIME_1=44. Тарифы: time_1..time_4 (по времени) и traffic_1..traffic_4
# (по трафику) — уровни Новичок, Нетраннер, Кибер-самурай, Призрак.
# STARS_RUB_RATE=1.6
# STARS_TIME_1=44
# STARS_TIME_3=156
# STARS_TRAFFIC_4=312

# Файл журнала заказов (идемпотентность оплат). На Railway без volume файл
# обнуляется при передеплое — это не страшно: бот дополнительно помечает оплату
# в комментарии клиента в панели и повторно ключ не выдаёт.
# PAYMENT_STORE_FILE=data/payments.json

# --- Служебные команды администратора: ОДИН переключатель ---
# ADMIN_TOOLS=1 — включить, ADMIN_TOOLS=0 или удалить переменную — скрыть.
# Что скрывается: /inbounds, /reset_vpn, /panel_debug, /totp, /groups, /payments,
# /revoke, а также /test_pay и /platega_check. Когда выключено, этих команд в боте
# нет вообще: их не видно в меню Telegram и они не отвечают — пользователи видят
# только рабочие разделы (тарифы, ключ, инструкция, приглашения, поддержка).
# /myid остаётся доступной всегда: по ней админ видит свой ID, состояние оплаты
# (режим, магазин Platega, Callback URL) и подсказку, какой переменной вернуть
# служебные команды и проверки оплаты (данная подсказка видна только администратору).
# ADMIN_TOOLS=1

# --- Бесплатный тест на 24 часа (/test_vpn) ---
# TRIAL_PUBLIC=0 (по умолчанию, рекомендуется) — тест ТОЛЬКО администратору.
#   Пользователи не видят бесплатный доступ вообще: нет кнопки в меню, нет строки
#   в /start, нет пункта в тарифах, нет упоминания в соглашении и в приглашениях.
# TRIAL_PUBLIC=1 — тест доступен всем: кнопка «🔑 Получить тестовый VPN (24 часа)»
#   у каждого пользователя, ключ на 24 часа / 1 ГБ (и бесплатный пункт в тарифах).
# TRIAL_PUBLIC=0

# --- Сервис и пользовательское соглашение ---
# Название сервиса: подставляется в тексты (в том числе в соглашение /terms).
# SERVICE_NAME=MyVPN

# Username поддержки без @ — показывается в разделе «Поддержка», в кнопке
# «💬 Поддержка», в соглашении (п. 10.1) и в политике (п. 5.3). Если переменная
# не задана, используется
# стандартный контакт @Darktier_support; заданная переменная его перекрывает
# (что именно видят клиенты, видно в /myid).
# SUPPORT_USERNAME=Darktier_support

# Email поддержки — п. 10.1 соглашения и раздел «Поддержка».
# SUPPORT_EMAIL=darktier.online@gmail.com

# Кто оказывает услугу: ИП/ООО/самозанятый, город, ИНН. Если задано — в подзаголовке
# соглашения появится строка «Исполнитель: …». Не задано — строка не показывается.
# TERMS_OPERATOR=ИП Иванов И.И., г. Москва, ИНН 000000000000

# Дата редакции соглашения и политики конфиденциальности (меняйте вручную при правках
# текста). Если переменная не задана — 22.09.2026.
# TERMS_UPDATED=22.09.2026

# --- Промо-доступ (15 дней, 10 ГБ, бесплатно) ---
# Пункт «🎉 Промо-доступ» в тарифах: бесплатный ключ на 15 дней / 10 ГБ, 1 устройство.
# PROMO_ENABLED=0 — убрать промо совсем (тариф закончился): нет пункта в тарифах и
#   нет выдачи, даже по прямой команде.
# PROMO_ONCE=1 (по умолчанию) — один раз на аккаунт: после активации пункт пропадает
#   из тарифов, иначе бесплатные 15 дней можно оформлять бесконечно.
#   PROMO_ONCE=0 — без ограничения (удобно проверить: после /revoke промо можно взять снова).
# Промо не активируется, если у аккаунта есть (или была) платная подписка.
# PROMO_ENABLED=1
# PROMO_ONCE=1

# --- Кнопки тестового доступа ---
# TRIAL_BUTTON=0 (по умолчанию) — кнопок теста нет ни у кого, включая администратора:
#   не видно ни «🔑 Получить тестовый VPN (24 часа)» в меню, ни «🔑 Тестовый ключ (24 ч)»
#   в профиле, ни пункта «🎁 Тестовый период» в тарифах. Бот выглядит полностью боевым.
#   Сам ключ остаётся доступен админу командой /test_vpn (и /test_pay для проверки выдачи).
# TRIAL_BUTTON=1 — кнопки возвращаются тем, кому доступен тест (см. TRIAL_PUBLIC).
# TRIAL_BUTTON=0

# --- Соглашение при первом запуске ---
# TERMS_ACCEPT=1 (по умолчанию) — новый пользователь сначала видит соглашение и кнопку
#   «✅ Согласен — продолжить». До подтверждения бот не открывает меню и не отвечает
#   по делу на /help, /profile, /invite, /test_vpn — только показывает соглашение.
# TERMS_ACCEPT=0 — экран выключен: бот сразу показывает меню (соглашение остаётся в /terms).
# Политика конфиденциальности (/privacy) и обе кнопки — «📄 Соглашение» и «🔒 Политика
# конфиденциальности» — работают всегда, независимо от этой переменной.
# TERMS_ACCEPT=1

# Файл с отметками о принятии соглашения (кто и когда подтвердил).
# TERMS_STORE_FILE=data/terms.json

# --- Реферальная программа («пригласи друга») ---
# Что происходит: за друга, который ОПЛАТИЛ тариф, пригласивший получает
# REFERRAL_BONUS_DAYS дней подписки (сразу или в копилку до следующей оплаты),
# а сам приглашённый — REFERRAL_INVITED_BONUS_DAYS дней к первой оплате.
# Выключить программу: REFERRAL_ENABLED=0 (ссылки перестанут работать).
# REFERRAL_ENABLED=1
# REFERRAL_BONUS_DAYS=7
# REFERRAL_INVITED_BONUS_DAYS=3

# Username бота для реферальной ссылки t.me/<бот>?start=ref_<id>.
# Можно не задавать: бот спросит его у Telegram при старте.
# BOT_USERNAME=myvpnbot

# Журнал приглашений (кто кого позвал, копилка дней). На Railway без volume
# может обнулиться при передеплое — подписки при этом не пострадают,
# статистика приглашений начнётся заново.
# REFERRAL_STORE_FILE=data/referrals.json
