# =================================================================
# ОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ ДЛЯ RAILWAY (Variables)
# =================================================================

# 1. Токен бота из Telegram (получи у @BotFather)
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. Твой личный Telegram ID (узнай у бота командой /myid)
ADMIN_ID=123456789

# 3. Полный адрес твоей панели 3x-ui РОВНО так, как ты открываешь её в браузере:
#    - БЕЗ слэша на конце!
#    - Обязательно укажи порт (например :2053)
#    - Если при установке панели настроен секретный путь (webBasePath), укажи его:
#      Примеры:
#      http://194.87.12.34:2053
#      https://194.87.12.34:2053
#      https://vpn.example.com:2053/mysecret
XUI_URL=http://194.87.12.34:2053

# 4. Логин администратора панели 3x-ui
XUI_USERNAME=admin

# 5. Пароль администратора панели 3x-ui
XUI_PASSWORD=your_strong_password


# =================================================================
# РЕКОМЕНДУЕМЫЕ / ОПЦИОНАЛЬНЫЕ ПЕРЕМЕННЫЕ
# =================================================================

# ID подключения в 3x-ui (VLESS + TCP + Reality).
# Если оставить 0 или не указывать, бот автоматически выберет первое подходящее!
# Чтобы зафиксировать конкретное, посмотри список командой /inbounds у бота.
XUI_INBOUND_ID=1

# Группа, в которую бот складывает всех своих клиентов (раздел «Группы» в 3x-ui).
# Требуется панель 3x-ui 3.2 или новее.
# Укажи название УЖЕ СОЗДАННОЙ группы — бот найдёт её в панели и будет складывать
# клиентов в неё. Регистр не важен: «bot-test» найдёт группу «Bot-Test».
# Если такой группы в панели нет, бот создаст новую и предупредит об этом в ответе.
# Посмотреть точные названия групп панели: команда /groups у бота.
# XUI_CLIENT_GROUP=bot-test

# Если в 3x-ui сгенерирован API Token (в настройках панели) — можно указать его.
# При указании XUI_TOKEN логин и пароль не требуются, и работает даже с 2FA.
# XUI_TOKEN=your_3xui_bearer_token

# Секрет двухфакторной аутентификации (Google Authenticator), если в панели 3x-ui
# включена 2FA: Settings -> Security -> Two-factor authentication -> секрет из QR-кода.
# Бот сам считает 6-значный код при каждом входе в панель. Можно вставить как сам
# base32-секрет, так и целиком ссылку otpauth://... из QR-кода (пробелы не важны).
# Проверить секрет: python bot.py --totp (локально) или команда /totp (в боте).
# XUI_2FA_SECRET=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP

# Адрес VPN-сервера для клиентов внутри ключа vless://.
# По умолчанию бот берёт IP/домен из XUI_URL.
# Укажи, если панель висит на одном IP/домене, а VPN трафик идёт через другой:
# VPN_HOST=194.87.12.34

# Порт VPN-подключения (по умолчанию берётся порт из настроек входящего подключения в панели):
# VPN_PORT=443

# Ручное переопределение параметров Reality (по умолчанию бот считывает их автоматически из панели):
# REALITY_PUBLIC_KEY=
# REALITY_SNI=www.microsoft.com
# REALITY_SHORT_ID=
# REALITY_FP=chrome

# Прокси для запросов бота к панели (если хостер сервера блокирует прямые запросы из дата-центров Railway):
# XUI_PROXY=http://user:pass@host:port

# =================================================================
# ОПЛАТА ПОДПИСОК (ОПЦИОНАЛЬНО)
# =================================================================
# Режим приёма оплаты. Если не задан, бот выбирает сам:
#   provider → если задан PAYMENT_PROVIDER_TOKEN,
#   иначе yookassa → если заданы ключи ЮKassa,
#   иначе crypto → если задан CRYPTOBOT_TOKEN,
#   иначе stars.
#   • stars     — Telegram Stars (⭐️ XTR). Ничего, кроме выбора режима, не нужно:
#                 оплата приходит звёздами, ключ выдаётся сразу после оплаты.
#   • crypto    — крипта через @CryptoBot (Crypto Pay API): счёт в USDT/TON/…,
#                 клиент платит в CryptoBot, ключ выдаётся после подтверждения оплаты
#                 (вебхук или опрос API). Не нужны юрлицо, договор и фискализация.
#                 Инструкция: CRYPTOPAY.md в этом репозитории.
#   • provider  — оплата КАРТОЙ прямо в чате Telegram через платёжный токен BotFather.
#                 Для цифровых товаров Telegram разрешает только Stars, поэтому режим
#                 включай осознанно (например, если продаёшь не цифровой товар).
#   • yookassa  — прямая интеграция с ЮKassa: бот создаёт платёж, присылает ссылку
#                 на оплату (карта/СБП), оплата подтверждается вебхуком.
#   • off       — приём оплаты выключен (остаётся бесплатный тестовый доступ).
# PAYMENTS_MODE=stars

# --- КРИПТА ЧЕРЕЗ @CryptoBot (Crypto Pay API) — только для режима crypto ---
# Пошаговая инструкция: CRYPTOPAY.md в этом репозитории.
# Тест:  @CryptoTestnetBot -> /pay -> My Apps -> Create App -> API Token (тестовые монеты).
# Бой:   @CryptoBot        -> /pay -> My Apps -> Create App -> API Token (реальные деньги).
# Токены тестовой и боевой сети не взаимозаменяемы!
# CRYPTOBOT_TOKEN=12345:AAxxxxxxxxxxxxxxxxxxxxxxxxxx
# CRYPTOBOT_TEST=1                # 1 — тестовая сеть (testnet-pay.crypt.bot)
# CRYPTOBOT_ASSET=USDT            # валюта счёта: USDT, TON, BTC, USDC, BUSD
# CRYPTOBOT_RUB_RATE=95           # рублей за 1 единицу валюты; пусто — курс берётся из Crypto Pay
# CRYPTOBOT_INVOICE_TTL=3600      # сколько секунд живёт счёт
# CRYPTOBOT_POLL_INTERVAL=60      # как часто проверять оплаты без вебхука (минимум 15)
# CRYPTOBOT_API_URL=              # менять не нужно: бот сам выбирает тест/бой по CRYPTOBOT_TEST
#
# Проверка выдачи ключа БЕЗ оплаты (только для админа): команда /test_pay.
# Бот проходит тот же путь, что после настоящей оплаты (клиент в 3x-ui + сообщение
# с ключом), но денег не списывает и в выручку не попадает. В тестовой сети
# (CRYPTOBOT_TEST=1) включается автоматически; после проверки переменную можно убрать.
# PAYMENTS_ALLOW_TEST_PAY=1
#
# Вебхук (необязательно, но ключ приходит мгновенно):
# приложение Crypto Pay -> Webhooks -> https://ваш-домен/cryptobot/webhook
# (событие invoice_paid; для тестовой сети — в приложении @CryptoTestnetBot).

# --- ОПЛАТА КАРТОЙ ЧЕРЕЗ TELEGRAM (@BotFather) — только для режима provider ---
# Пошаговая инструкция: TELEGRAM_PAYMENTS.md в этом репозитории.
# @BotFather -> /mybots -> твой бот -> Bot Settings -> Payments -> ЮKassa.
#   • "Connect ЮKassa Test"  — тестовый токен вида 381764678:TEST:100037
#                              (оплата тестовой картой 5555 5555 5555 4477);
#   • "Connect ЮKassa Live"  — бот спросит shopId и shopArticleId (отправь 0),
#                              выдаст боевой токен вида x:LIVE:...
# Для боевого режима магазин ЮKassa нужно перевести на email-протокол:
# напиши в поддержку ЮKassa (ecommerce@yoomoney.ru) свой ShopID.
# PAYMENT_PROVIDER_TOKEN=381764678:TEST:100037

# Чек 54-ФЗ (ЮKassa в Telegram): 1 — бот передаёт данные чека в provider_data и
# просит у покупателя email для чека, 0 — не передавать (по умолчанию).
# Включай 1 только если фискализация подключена (чеки от ЮKassa или своя касса).
# TELEGRAM_SEND_RECEIPT=0
# Ставка НДС в чеке: 1 — без НДС, 2 — 0%, 3 — 10%, 4 — 20%, 5 — 10/110, 6 — 20/120
# TELEGRAM_RECEIPT_VAT_CODE=1

# --- ЮKASSA НАПРЯМУЮ (API v3) — только для режима yookassa ---
# Подробная пошаговая инструкция: YOOKASSA.md в этом репозитории.
# Личный кабинет ЮKassa -> Интеграция -> Ключи API (shopId + секретный ключ).
# Для тестов создай ТЕСТОВЫЙ магазин: ключ начинается с test_ .
# YOOKASSA_SHOP_ID=123456
# YOOKASSA_SECRET_KEY=test_xxxxxxxxxxxxxxxxxxxx
# YOOKASSA_TEST=1
# Адрес API (менять не нужно):
# YOOKASSA_API_URL=https://api.yookassa.ru/v3

# ВЕБХУК: при авторизации по shopId+ключу (Basic Auth) ЮKassa разрешает настраивать
# уведомления ТОЛЬКО в личном кабинете: Интеграция -> HTTP-уведомления ->
# https://ваш-домен/yookassa/webhook (событие payment.succeeded).
# Адрес бот покажет в /panel_debug — он же в ответе на запрос Railway.
# Если у тебя есть OAuth-токен ЮKassa (партнёрская программа), бот зарегистрирует
# вебхук сам через API — укажи его здесь:
# YOOKASSA_OAUTH_TOKEN=token_xxxxxxxxxxxxxxxxxxxx

# Чек 54-ФЗ: 1..6 — ставка НДС (чек передаёт бот), 0 — не передавать (по умолчанию).
# Оставь 0, если фискализации нет или чеки формирует сам сервис («Чеки от ЮKassa»):
# иначе создание платежа может падать с ошибкой.
# YOOKASSA_VAT_CODE=0

# Публичный адрес сервиса (Railway отдаёт его как RAILWAY_PUBLIC_DOMAIN и бот
# подставляет сам). Нужен, чтобы ЮKassa знала, куда присылать уведомления:
# PUBLIC_BASE_URL=https://your-service.up.railway.app

# Порт веб-сервера бота (health /healthz + вебхук ЮKassa). Railway задаёт сам.
# PORT=8080

# Курс пересчёта рублей в звёзды для режима Stars: 1 ⭐️ ≈ 1.6 ₽.
# Цену конкретного тарифа в звёздах можно задать точно, например STARS_BASIC=100.
# STARS_RUB_RATE=1.6
# STARS_BASIC=100
# STARS_STANDARD=250
# STARS_PREMIUM=750

# Файл журнала заказов (идемпотентность оплат). На Railway без volume файл
# обнуляется при передеплое — это не страшно: бот дополнительно помечает оплату
# в комментарии клиента в панели и повторно ключ не выдаёт.
# PAYMENT_STORE_FILE=data/payments.json
